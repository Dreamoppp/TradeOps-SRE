# TradeOps Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database
# For local Windows development without Docker:
DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/tradeops
# For Docker Compose:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/tradeops

# Security / JWT
JWT_SECRET=tradeops-super-secret-key-change-in-production-2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Monitoring Engine
PROBE_INTERVAL_SECONDS=10
PROBE_TIMEOUT_SECONDS=3.0
FAILURE_THRESHOLD=2
RECOVERY_THRESHOLD=2

# Trading Simulator
SIMULATED_LATENCY_MIN_MS=50
SIMULATED_LATENCY_MAX_MS=200

# CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

